<DefaultWindow xmlns="https://spacestation14.io"
    Title="{Loc 'shift-schedule-console-title'}"
    MinSize="560 460"
    SetSize="560 460">
    <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True" Margin="10" SeparationOverride="8">
        <BoxContainer Orientation="Horizontal" HorizontalExpand="True" SeparationOverride="8">
            <LineEdit Name="TitleInput" PlaceHolder="{Loc 'shift-schedule-title-placeholder'}" HorizontalExpand="True" />
            <BoxContainer Orientation="Horizontal" SeparationOverride="4">
                <LineEdit Name="HoursInput" PlaceHolder="{Loc 'shift-schedule-hours-placeholder'}" MinWidth="44" />
                <Label Text=":" VerticalAlignment="Center" />
                <LineEdit Name="MinutesInput" PlaceHolder="{Loc 'shift-schedule-minutes-placeholder'}" MinWidth="44" />
                <Label Text=":" VerticalAlignment="Center" />
                <LineEdit Name="SecondsInput" PlaceHolder="{Loc 'shift-schedule-seconds-placeholder'}" MinWidth="44" />
            </BoxContainer>
        </BoxContainer>
        <LineEdit Name="DescriptionInput" PlaceHolder="{Loc 'shift-schedule-description-placeholder'}" HorizontalExpand="True" />
        <BoxContainer Orientation="Horizontal" SeparationOverride="8">
            <Button Name="SaveButton" Text="{Loc 'shift-schedule-add'}" />
            <Button Name="CancelButton" Text="{Loc 'shift-schedule-cancel'}" />
            <Button Name="ToggleButton" />
        </BoxContainer>
        <BoxContainer Orientation="Horizontal" SeparationOverride="8">
            <LineEdit Name="ScheduleCodeInput" PlaceHolder="{Loc 'shift-schedule-code-placeholder'}" HorizontalExpand="True" />
            <Button Name="ExportCodeButton" Text="{Loc 'shift-schedule-export-code'}" />
            <Button Name="ImportCodeButton" Text="{Loc 'shift-schedule-import-code'}" />
        </BoxContainer>
        <Label Name="StatusLabel" HorizontalExpand="True" />
        <PanelContainer StyleClasses="PanelDark" HorizontalExpand="True" VerticalExpand="True">
            <ScrollContainer HorizontalExpand="True" VerticalExpand="True">
                <BoxContainer Name="EntriesContainer" Orientation="Vertical" HorizontalExpand="True" SeparationOverride="6" />
            </ScrollContainer>
        </PanelContainer>
    </BoxContainer>
</DefaultWindow>
