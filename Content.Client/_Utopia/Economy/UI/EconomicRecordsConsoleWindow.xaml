<controls:FancyWindow xmlns="https://spacestation14.io"
            xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
            Title="{Loc 'economic-records-console-window-title'}"
            MinSize="600 400">
    <BoxContainer Orientation="Vertical">
        <BoxContainer Margin="13 5 13 0" HorizontalExpand="true" VerticalAlignment="Center">
            <OptionButton Name="StationRecordsFilterType" MinWidth="220" Margin="0 0 5 0"/>
            <LineEdit Name="StationRecordsFiltersValue" Margin="15 0 0 0"
                PlaceHolder="{Loc 'general-station-record-for-filter-line-placeholder'}"
                HorizontalExpand="True"/>
            <Button Name="StationRecordsFiltersReset" Text="{Loc 'general-station-record-console-reset-filters'}" Margin="5 0 0 0"/>
        </BoxContainer>
        <BoxContainer VerticalExpand="True" Margin="5">
            <BoxContainer Orientation="Vertical" Margin="10 10" MinWidth="220">
                <Label Name="RecordListingStatus" Visible="False"/>
                <ScrollContainer VerticalExpand="True">
                    <ItemList Name="RecordListing"/>
                </ScrollContainer>
            </BoxContainer>
            <BoxContainer Orientation="Vertical" Margin="5" HorizontalExpand="True">
                <Label Name="RecordContainerStatus" Visible="False" Text="{Loc 'general-station-record-console-select-record-info'}"/>
                <Control Name="RecordContainer" Visible="False">
                    <BoxContainer Orientation="Vertical" Margin="5">
                        <BoxContainer Orientation="Horizontal" Margin="2 10">
                            <Label Name="BlockStatusLabel" Text="{Loc 'economic-records-console-window-block-status'}"/>
                            <CheckBox Name="BlockAccountButton" Margin="5 0 0 0"/>
                        </BoxContainer>
                        <Label Name="RecordName" StyleClasses="LabelBig"/>
                        <BoxContainer Orientation="Horizontal">
                            <Label Name="RecordJob"/>
                            <TextureRect Name="JobIcon"
                                TextureScale="2 2"
                                Margin="3 5"
                                VerticalAlignment="Center"/>
                        </BoxContainer>
                        <Label Name="AccountIdLabel"/>
                        <Label Name="BalanceLabel"/>
                        <Label Name="HistoryHeader" Margin="0 10 0 2"/>
                        <PanelContainer StyleClasses="AngleRect">
                            <ScrollContainer MinSize="0 100" Margin="5">
                                <BoxContainer Name="HistoryList" Orientation="Vertical"/>
                            </ScrollContainer>
                        </PanelContainer>
                    </BoxContainer>
                </Control>
            </BoxContainer>
        </BoxContainer>
        <PanelContainer StyleClasses="LowDivider" />
        <BoxContainer Orientation="Vertical">
            <BoxContainer Orientation="Horizontal" Margin="10 2 5 0" VerticalAlignment="Bottom">
                <Label Text="{Loc 'economic-records-console-flavor-left'}" StyleClasses="WindowFooterText" />
                <Label Text="{Loc 'economic-records-console-flavor-right'}" StyleClasses="WindowFooterText"
                        HorizontalAlignment="Right" HorizontalExpand="True"  Margin="0 0 5 0" />
                <TextureRect StyleClasses="NTLogoDark" Stretch="KeepAspectCentered"
                        VerticalAlignment="Center" HorizontalAlignment="Right" SetSize="19 19"/>
            </BoxContainer>
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
