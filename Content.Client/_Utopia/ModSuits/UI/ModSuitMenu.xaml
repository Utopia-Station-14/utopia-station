<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      xmlns:customControls="clr-namespace:Content.Client.Administration.UI.CustomControls"
                      Title="{Loc 'modsuit-ui-title'}"
                      MinSize="800 480"
                      SetSize="860 500">
    <BoxContainer Orientation="Horizontal" HorizontalExpand="True" VerticalExpand="True">
        <BoxContainer Margin="12 10 10 12" SetWidth="230" MaxWidth="230" Orientation="Vertical" VerticalExpand="True">
            <BoxContainer Orientation="Horizontal" HorizontalExpand="True">
                <Label Text="{Loc 'modsuit-ui-modules-header'}" StyleClasses="LabelKeyText" HorizontalExpand="True" />
                <Label Name="ModulesCountLabel" StyleClasses="LabelSubText" HorizontalAlignment="Right" />
            </BoxContainer>
            <customControls:HSeparator StyleClasses="HighDivider" Margin="0 5 0 8" />
            <PanelContainer VerticalExpand="True" HorizontalExpand="True" RectClipContent="True">
                <PanelContainer.PanelOverride>
                    <gfx:StyleBoxFlat BackgroundColor="#0E0E1299"
                                      BorderColor="#FFFFFF1F"
                                      BorderThickness="1" />
                </PanelContainer.PanelOverride>
                <ScrollContainer HScrollEnabled="False" HorizontalExpand="True" VerticalExpand="True" Margin="6">
                    <BoxContainer Orientation="Vertical" HorizontalExpand="True">
                        <Label Name="NoModulesLabel"
                               Text="{Loc 'modsuit-ui-no-modules'}"
                               StyleClasses="LabelSubText"
                               HorizontalAlignment="Center"
                               Margin="0 16 0 0"
                               Visible="False" />
                        <BoxContainer Name="ModulesContainer" Orientation="Vertical" SeparationOverride="5" />
                    </BoxContainer>
                </ScrollContainer>
            </PanelContainer>
        </BoxContainer>

        <customControls:VSeparator StyleClasses="LowDivider" Margin="0 6 0 6" />

        <BoxContainer Margin="14 10 14 12" Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True">
            <BoxContainer Orientation="Horizontal"
                          HorizontalExpand="True"
                          VerticalExpand="True"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Top"
                          Margin="0 4 0 0"
                          SeparationOverride="28">

                <BoxContainer Orientation="Vertical" VerticalAlignment="Top" SeparationOverride="8">
                    <PanelContainer Name="SchematicPanel" MinSize="170 230">
                        <PanelContainer.PanelOverride>
                            <gfx:StyleBoxTexture Modulate="#1B1B1E"
                                                 PatchMarginBottom="10"
                                                 PatchMarginLeft="10"
                                                 PatchMarginRight="10"
                                                 PatchMarginTop="10" />
                        </PanelContainer.PanelOverride>
                        <BoxContainer HorizontalExpand="True" VerticalExpand="True" MinSize="170 230">
                            <SpriteView Name="WearerView"
                                        Scale="3.5 3.5"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        HorizontalExpand="True"
                                        VerticalExpand="True"
                                        Visible="False" />
                            <Label Name="CoreLabel"
                                   Text="{Loc 'modsuit-ui-core-label'}"
                                   StyleClasses="LabelKeyText"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   HorizontalExpand="True" />
                        </BoxContainer>
                    </PanelContainer>

                    <controls:StripeBack>
                        <PanelContainer>
                            <BoxContainer Orientation="Vertical" Margin="8 5 8 3">
                                <Label Name="NameLabel"
                                       StyleClasses="LabelKeyText"
                                       ClipText="True" />
                                <Label Name="JobLabel"
                                       StyleClasses="LabelSubText"
                                       ClipText="True" />
                            </BoxContainer>
                        </PanelContainer>
                    </controls:StripeBack>
                </BoxContainer>

                <BoxContainer MinSize="0 230" VerticalAlignment="Top">
                    <BoxContainer Name="PartSlots"
                                  Orientation="Vertical"
                                  SeparationOverride="10"
                                  VerticalAlignment="Center" />
                </BoxContainer>
            </BoxContainer>

            <PanelContainer Name="LockedPanel" HorizontalExpand="True" Margin="0 0 0 6" Visible="False">
                <PanelContainer.PanelOverride>
                    <gfx:StyleBoxFlat BackgroundColor="#5A22222E"
                                      BorderColor="#C0404099"
                                      BorderThickness="1"
                                      ContentMarginLeftOverride="8"
                                      ContentMarginRightOverride="8"
                                      ContentMarginTopOverride="4"
                                      ContentMarginBottomOverride="4" />
                </PanelContainer.PanelOverride>
                <Label Name="LockedLabel"
                       StyleClasses="LabelSubText"
                       HorizontalAlignment="Center" />
            </PanelContainer>

            <Button Name="ToggleAllButton" HorizontalExpand="True" MinHeight="40" />
            <controls:StripeBack HorizontalExpand="True" Margin="0 5 0 0">
                <PanelContainer>
                    <BoxContainer Orientation="Horizontal" HorizontalExpand="True" Margin="10 6 10 4">
                        <Label Text="{Loc 'modsuit-ui-speed-title'}"
                               HorizontalExpand="True"
                               VerticalAlignment="Center" />
                        <controls:SwitchButton Name="SpeedSwitch"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center" />
                    </BoxContainer>
                </PanelContainer>
            </controls:StripeBack>
        </BoxContainer>

        <customControls:VSeparator StyleClasses="LowDivider" Margin="0 6 0 6" />
        <BoxContainer Margin="10 10 12 12" SetWidth="270" MaxWidth="270" Orientation="Vertical" VerticalExpand="True">
            <controls:StripeBack Margin="0 0 0 8">
                <PanelContainer>
                    <Label Text="{Loc 'modsuit-ui-stats-header'}"
                           StyleClasses="LabelKeyText"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="0 5 0 3" />
                </PanelContainer>
            </controls:StripeBack>

            <ScrollContainer HScrollEnabled="False" HorizontalExpand="True" VerticalExpand="True">
                <BoxContainer Orientation="Vertical" HorizontalExpand="True" SeparationOverride="8">

                    <PanelContainer Name="StatusPanel" HorizontalExpand="True">
                        <PanelContainer.PanelOverride>
                            <gfx:StyleBoxFlat BackgroundColor="#FFFFFF0D"
                                              BorderColor="#FFFFFF40"
                                              BorderThickness="1"
                                              ContentMarginLeftOverride="10"
                                              ContentMarginRightOverride="10"
                                              ContentMarginTopOverride="7"
                                              ContentMarginBottomOverride="7" />
                        </PanelContainer.PanelOverride>
                        <BoxContainer HorizontalExpand="True">
                            <RichTextLabel Text="{Loc 'modsuit-ui-status-label'}" HorizontalExpand="True" VerticalAlignment="Center" />
                            <RichTextLabel Name="StatusValueLabel" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </BoxContainer>
                    </PanelContainer>

                    <PanelContainer HorizontalExpand="True">
                        <PanelContainer.PanelOverride>
                            <gfx:StyleBoxFlat BackgroundColor="#FFFFFF08"
                                              BorderColor="#FFFFFF1F"
                                              BorderThickness="1"
                                              ContentMarginLeftOverride="10"
                                              ContentMarginRightOverride="10"
                                              ContentMarginTopOverride="7"
                                              ContentMarginBottomOverride="8" />
                        </PanelContainer.PanelOverride>
                        <BoxContainer Orientation="Vertical" HorizontalExpand="True" SeparationOverride="5">
                            <BoxContainer HorizontalExpand="True">
                                <RichTextLabel Text="{Loc 'modsuit-ui-charge-label'}" HorizontalExpand="True" />
                                <RichTextLabel Name="ChargeValueLabel" HorizontalAlignment="Right" />
                            </BoxContainer>
                            <ProgressBar Name="ChargeBar" SetHeight="14" MaxValue="1" Value="0" />
                        </BoxContainer>
                    </PanelContainer>

                    <PanelContainer Name="PartsPanel" HorizontalExpand="True">
                        <PanelContainer.PanelOverride>
                            <gfx:StyleBoxFlat BackgroundColor="#0E0E1299"
                                              BorderColor="#FFFFFF1F"
                                              BorderThickness="1"
                                              ContentMarginLeftOverride="10"
                                              ContentMarginRightOverride="10"
                                              ContentMarginTopOverride="7"
                                              ContentMarginBottomOverride="7" />
                        </PanelContainer.PanelOverride>
                        <BoxContainer HorizontalExpand="True">
                            <RichTextLabel Text="{Loc 'modsuit-ui-parts-label'}" HorizontalExpand="True" />
                            <RichTextLabel Name="PartsValueLabel" HorizontalAlignment="Right" />
                        </BoxContainer>
                    </PanelContainer>

                    <controls:StripeBack>
                        <PanelContainer>
                            <Label Text="{Loc 'modsuit-ui-power-header'}"
                                   StyleClasses="LabelKeyText"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="0 5 0 3" />
                        </PanelContainer>
                    </controls:StripeBack>

                    <PanelContainer HorizontalExpand="True">
                        <PanelContainer.PanelOverride>
                            <gfx:StyleBoxFlat BackgroundColor="#0E0E1299"
                                              BorderColor="#FFFFFF1F"
                                              BorderThickness="1"
                                              ContentMarginLeftOverride="10"
                                              ContentMarginRightOverride="10"
                                              ContentMarginTopOverride="8"
                                              ContentMarginBottomOverride="8" />
                        </PanelContainer.PanelOverride>
                        <BoxContainer Orientation="Vertical" HorizontalExpand="True" SeparationOverride="6">
                            <BoxContainer HorizontalExpand="True">
                                <RichTextLabel Text="{Loc 'modsuit-ui-draw-total'}" HorizontalExpand="True" />
                                <RichTextLabel Name="TotalDrawValueLabel" HorizontalAlignment="Right" />
                            </BoxContainer>
                            <customControls:HSeparator StyleClasses="LowDivider" />
                            <BoxContainer HorizontalExpand="True">
                                <RichTextLabel Text="{Loc 'modsuit-ui-draw-speed'}" HorizontalExpand="True" />
                                <RichTextLabel Name="SpeedDrawValueLabel" HorizontalAlignment="Right" />
                            </BoxContainer>
                            <BoxContainer HorizontalExpand="True">
                                <RichTextLabel Text="{Loc 'modsuit-ui-draw-modules'}" HorizontalExpand="True" />
                                <RichTextLabel Name="ModulesDrawValueLabel" HorizontalAlignment="Right" />
                            </BoxContainer>
                            <BoxContainer HorizontalExpand="True">
                                <RichTextLabel Text="{Loc 'modsuit-ui-swap-cost'}" HorizontalExpand="True" />
                                <RichTextLabel Name="SwapCostValueLabel" HorizontalAlignment="Right" />
                            </BoxContainer>
                        </BoxContainer>
                    </PanelContainer>
                </BoxContainer>
            </ScrollContainer>
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
